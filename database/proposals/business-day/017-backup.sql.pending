-- REVIEW ONLY. Requires separate approval and stopped writers before execution.
-- Operator must first prove that this exact path does not exist on the SQL host.
SET NOCOUNT ON;
IF DB_NAME()<>N'SongLamPms_Design'
 OR CONVERT(varchar(36),(SELECT database_guid FROM sys.database_recovery_status WHERE database_id=DB_ID()))<>'C4DD399E-5661-4741-A424-5ABFEEFBC1AC'
 OR CONVERT(nvarchar(128),(SELECT value FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.Environment'))<>N'test'
 THROW 54700,'Day017 target mismatch.',1;
IF EXISTS(SELECT 1 FROM msdb.dbo.backupset b JOIN msdb.dbo.backupmediafamily m ON m.media_set_id=b.media_set_id
 WHERE m.physical_device_name=N'C:\Program Files\Microsoft SQL Server\MSSQL16.SQLEXPRESS\MSSQL\Backup\SongLamPms_Design_Day017_20261114_7bb2fadc.bak')
 THROW 54701,'Day017 backup path already registered; do not append or overwrite.',1;
BACKUP DATABASE [SongLamPms_Design]
 TO DISK=N'C:\Program Files\Microsoft SQL Server\MSSQL16.SQLEXPRESS\MSSQL\Backup\SongLamPms_Design_Day017_20261114_7bb2fadc.bak'
 WITH COPY_ONLY,CHECKSUM,NOINIT,NAME=N'SongLam Day017 test business date alignment';
RESTORE VERIFYONLY
 FROM DISK=N'C:\Program Files\Microsoft SQL Server\MSSQL16.SQLEXPRESS\MSSQL\Backup\SongLamPms_Design_Day017_20261114_7bb2fadc.bak'
 WITH CHECKSUM;
SELECT CONVERT(varchar(36),b.backup_set_uuid) BackupSetUuid,b.has_backup_checksums,b.is_copy_only,
 b.backup_start_date,b.backup_finish_date,m.physical_device_name
FROM msdb.dbo.backupset b JOIN msdb.dbo.backupmediafamily m ON m.media_set_id=b.media_set_id
WHERE m.physical_device_name=N'C:\Program Files\Microsoft SQL Server\MSSQL16.SQLEXPRESS\MSSQL\Backup\SongLamPms_Design_Day017_20261114_7bb2fadc.bak'
ORDER BY b.backup_finish_date DESC;
