-- R1 service membership only. No new application permission or broad SELECT.
SET NOCOUNT ON;
SET XACT_ABORT ON;
DECLARE @ApprovalReference nvarchar(200)=N'USER-20261112-MODULES-5-6';
IF NULLIF(@ApprovalReference,N'') IS NULL THROW 53910,'R1 membership execution reference required.',1;
IF DB_NAME()<>N'SongLamPms_Design' OR CONVERT(nvarchar(128),SERVERPROPERTY('ServerName'))<>N'DESKTOP-9EPI86K\SQLEXPRESS'
 OR NOT EXISTS(SELECT 1 FROM sys.database_recovery_status WHERE database_id=DB_ID() AND database_guid='C4DD399E-5661-4741-A424-5ABFEEFBC1AC')
 THROW 53911,'Unexpected R1 membership target.',1;
IF @@TRANCOUNT<>0 THROW 53912,'No ambient transaction allowed.',1;
IF NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.Environment' AND CONVERT(nvarchar(128),value)=N'test')
 OR NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.TestIdentity' AND CONVERT(nvarchar(128),value)=N'eb18c6f2-373d-4a83-a34f-d9809f1cbc7a')
 THROW 53913,'D1 marker required.',1;
IF OBJECT_ID(N'pms.usp_AppCatalogRead',N'P') IS NULL OR DATABASE_PRINCIPAL_ID(N'pms_web_catalog_reader') IS NULL
 OR NOT EXISTS(SELECT 1 FROM sys.database_principals WHERE name=N'pms_web_auth_test' AND type=N'U' AND sid=SUSER_SID(N'DESKTOP-9EPI86K\songlam_pms_test'))
 THROW 53914,'R1 RPC/role or verified service identity missing.',1;
IF ISNULL(IS_ROLEMEMBER(N'pms_web_catalog_reader',N'pms_web_auth_test'),-1)<>0
 THROW 53915,'Existing or unknown R1 membership requires review.',1;
BEGIN TRY
 BEGIN TRANSACTION;
 ALTER ROLE [pms_web_catalog_reader] ADD MEMBER [pms_web_auth_test];
 COMMIT;
 SELECT N'R1_MEMBERSHIP_COMMITTED_READ_INTEGRATION_NOT_VERIFIED' AS Status;
END TRY
BEGIN CATCH
 IF XACT_STATE()<>0 ROLLBACK;
 THROW;
END CATCH;
