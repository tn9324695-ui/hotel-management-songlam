-- Explicit 001/003 execution approved 2026-11-12; not an automatic installer.
-- No database is created; no user/login/data is seeded.
-- DBA must fill BOTH values only after separate written approval.
SET NOCOUNT ON;
SET XACT_ABORT ON;
DECLARE @ApprovedDatabase sysname = N'SongLamPms_Design';
DECLARE @ApprovalReference nvarchar(200) = N'USER-20261112-FIRST-TWO-001-003';
IF @ApprovedDatabase IS NULL OR NULLIF(@ApprovalReference,N'') IS NULL
    THROW 53000, 'SQL draft is not approved. No changes applied.', 1;
IF DB_NAME() <> @ApprovedDatabase OR DB_NAME() IN (N'master',N'model',N'msdb',N'tempdb')
    THROW 53001, 'Explicit approved database required.', 1;
IF SCHEMA_ID(N'pms') IS NULL THROW 53002, 'Existing pms schema required.', 1;
IF CONVERT(nvarchar(128),SERVERPROPERTY('ServerName'))<>N'DESKTOP-9EPI86K\SQLEXPRESS'
 OR NOT EXISTS(SELECT 1 FROM sys.database_recovery_status WHERE database_id=DB_ID()
 AND database_guid='C4DD399E-5661-4741-A424-5ABFEEFBC1AC')
 THROW 53003,'Approved physical target mismatch.',1;
IF NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.Environment' AND CONVERT(nvarchar(128),value)=N'test')
 OR NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.TestIdentity'
 AND CONVERT(nvarchar(128),value)=N'eb18c6f2-373d-4a83-a34f-d9809f1cbc7a')
 THROW 53004,'Approved D1 marker required.',1;
IF @@TRANCOUNT<>0 THROW 53005,'No ambient transaction permitted.',1;
IF DATABASE_PRINCIPAL_ID(N'pms_web_auth_reader') IS NOT NULL
 THROW 53006,'Existing role requires separate permission review.',1;
IF OBJECT_ID(N'pms.usp_AppEnvironment',N'P') IS NULL OR OBJECT_ID(N'pms.usp_AppAuthLookup',N'P') IS NULL
 OR OBJECT_ID(N'pms.usp_AppIdentity',N'P') IS NULL
 THROW 53007,'Deploy approved 001 before granting access.',1;
BEGIN TRY
BEGIN TRANSACTION;
-- Roles only; no login, AppUser account, user-role or PrincipalBinding is changed.
IF DATABASE_PRINCIPAL_ID(N'pms_web_auth_reader') IS NULL
 EXEC(N'CREATE ROLE pms_web_auth_reader AUTHORIZATION dbo');
GRANT EXECUTE ON OBJECT::pms.usp_AppEnvironment TO pms_web_auth_reader;
GRANT EXECUTE ON OBJECT::pms.usp_AppAuthLookup TO pms_web_auth_reader;
GRANT EXECUTE ON OBJECT::pms.usp_AppIdentity TO pms_web_auth_reader;
-- No SELECT/DML/ALTER/schema-wide EXECUTE or db_owner/sysadmin grants.
-- DBA separately reviews service-principal membership and effective inherited rights.
-- Do not give callers direct EXECUTE to usp_AppAssertActor/usp_AppAppendAudit.
-- Domain signing/countersigning and nested-module execution permissions are pending;
-- do not assume ownership chaining alone makes these private calls executable.
COMMIT;
END TRY
BEGIN CATCH
 IF XACT_STATE()<>0 ROLLBACK;
 THROW;
END CATCH;

