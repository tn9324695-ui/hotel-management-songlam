-- D3-P: no auth/actor/business permissions are added by this artifact.
SET NOCOUNT ON;
SET XACT_ABORT ON;
DECLARE @ApprovalReference nvarchar(200)=N'USER-20261112-MODULES-3-4';
IF NULLIF(@ApprovalReference,N'') IS NULL THROW 53610,'D3-P execution reference required.',1;
IF DB_NAME()<>N'SongLamPms_Design' OR CONVERT(nvarchar(128),SERVERPROPERTY('ServerName'))<>N'DESKTOP-9EPI86K\SQLEXPRESS'
 OR NOT EXISTS(SELECT 1 FROM sys.database_recovery_status WHERE database_id=DB_ID() AND database_guid='C4DD399E-5661-4741-A424-5ABFEEFBC1AC')
 THROW 53611,'Unexpected D3-P target.',1;
IF @@TRANCOUNT<>0 THROW 53612,'No ambient transaction allowed.',1;
IF NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.Environment' AND CONVERT(nvarchar(128),value)=N'test')
 OR NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.TestIdentity' AND CONVERT(nvarchar(128),value)=N'eb18c6f2-373d-4a83-a34f-d9809f1cbc7a')
 THROW 53613,'D1 marker required.',1;
IF DATABASE_PRINCIPAL_ID(N'pms_web_auth_test') IS NULL OR DATABASE_PRINCIPAL_ID(N'pms_web_session_executor') IS NULL
 OR OBJECT_ID(N'pms.WebSession',N'U') IS NULL
 OR OBJECT_ID(N'pms.usp_WebSessionProbe',N'P') IS NULL OR OBJECT_ID(N'pms.usp_WebSessionCreate',N'P') IS NULL
 OR OBJECT_ID(N'pms.usp_WebSessionGet',N'P') IS NULL OR OBJECT_ID(N'pms.usp_WebSessionDestroy',N'P') IS NULL
 THROW 53614,'Deploy D2-P and 005 first.',1;
IF NOT EXISTS(SELECT 1 FROM sys.database_principals WHERE name=N'pms_web_auth_test' AND type=N'U' AND sid=SUSER_SID(N'DESKTOP-9EPI86K\songlam_pms_test'))
 THROW 53615,'Service SID mismatch.',1;
IF ISNULL(IS_ROLEMEMBER(N'pms_web_session_executor',N'pms_web_auth_test'),-1)<>0
 THROW 53616,'Existing or unknown membership requires review.',1;
BEGIN TRY
 BEGIN TRANSACTION;
 ALTER ROLE [pms_web_session_executor] ADD MEMBER [pms_web_auth_test];
 COMMIT;
 SELECT N'D3P_COMMITTED_SESSION_INTEGRATION_NOT_YET_VERIFIED' AS Status;
END TRY
BEGIN CATCH
 IF XACT_STATE()<>0 ROLLBACK;
 THROW;
END CATCH;
