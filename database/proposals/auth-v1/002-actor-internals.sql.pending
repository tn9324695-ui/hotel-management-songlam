-- REVIEW DRAFT ONLY. Not referenced by any installer/bootstrap.
-- No database is created; no user/login/data is seeded.
-- DBA must fill BOTH values only after separate written approval.
SET NOCOUNT ON;
SET XACT_ABORT ON;
DECLARE @ApprovedDatabase sysname = NULL;
DECLARE @ApprovalReference nvarchar(200) = NULL;
IF @ApprovedDatabase IS NULL OR NULLIF(@ApprovalReference,N'') IS NULL
    THROW 53000, 'SQL draft is not approved. No changes applied.', 1;
IF DB_NAME() <> @ApprovedDatabase OR DB_NAME() IN (N'master',N'model',N'msdb',N'tempdb')
    THROW 53001, 'Explicit approved database required.', 1;
IF SCHEMA_ID(N'pms') IS NULL THROW 53002, 'Existing pms schema required.', 1;
IF CONVERT(nvarchar(128),SERVERPROPERTY('ServerName'))<>N'DESKTOP-9EPI86K\SQLEXPRESS'
 OR NOT EXISTS(SELECT 1 FROM sys.database_recovery_status WHERE database_id=DB_ID()
 AND database_guid='C4DD399E-5661-4741-A424-5ABFEEFBC1AC')
 THROW 53003,'Approved physical target mismatch.',1;
IF NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.Environment' AND CONVERT(nvarchar(128),value)=N'test')
 OR NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'SongLam.TestIdentity'
 AND CONVERT(nvarchar(128),value)=N'eb18c6f2-373d-4a83-a34f-d9809f1cbc7a')
 THROW 53004,'Approved D1 marker required.',1;
IF @@TRANCOUNT<>0 THROW 53005,'No ambient transaction permitted.',1;
IF OBJECT_ID(N'pms.usp_AppAssertActor') IS NOT NULL OR OBJECT_ID(N'pms.usp_AppAppendAudit') IS NOT NULL
 THROW 53006,'Existing helpers require separate upgrade review.',1;
BEGIN TRY
BEGIN TRANSACTION;
-- PRIVATE helpers: do not GRANT EXECUTE to web/service users.
-- This file does NOT define or enable a public domain command gateway.
EXEC sys.sp_executesql N'CREATE OR ALTER PROCEDURE pms.usp_AppAssertActor
 @AppUserId bigint,@PermissionCode varchar(80)
AS
BEGIN
 SET NOCOUNT ON;
 IF @@TRANCOUNT=0 OR XACT_STATE()<>1 THROW 53020,''An atomic domain transaction is required.'',1;
 IF COALESCE(APPLOCK_MODE(''public'',''SongLam:Inventory'',''Transaction''),''NoLock'')<>''Exclusive''
   THROW 53024,''Acquire the domain inventory lock before identity locks.'',1;
 IF @AppUserId IS NULL OR @AppUserId<=0 OR NULLIF(@PermissionCode,'''') IS NULL THROW 53014,''Invalid actor.'',1;
 -- The future approved domain RPC fixes PermissionCode; it is never a browser role.
 -- Locks remain held until that same domain transaction ends, including replay checks.
 IF NOT EXISTS(SELECT 1 FROM pms.AppUser u WITH(UPDLOCK,HOLDLOCK)
   JOIN pms.UserRole ur WITH(UPDLOCK,HOLDLOCK) ON ur.UserId=u.UserId
   JOIN pms.AppRole ar WITH(UPDLOCK,HOLDLOCK) ON ar.RoleId=ur.RoleId
   JOIN pms.RolePermission rp WITH(UPDLOCK,HOLDLOCK) ON rp.RoleId=ar.RoleId
   JOIN pms.Permission p WITH(UPDLOCK,HOLDLOCK) ON p.PermissionId=rp.PermissionId
   WHERE u.UserId=@AppUserId AND u.IsActive=1 AND ar.IsActive=1 AND p.Code=@PermissionCode)
   THROW 53015,''Actor authorization rejected.'',1;
END';

EXEC sys.sp_executesql N'CREATE OR ALTER PROCEDURE pms.usp_AppAppendAudit
 @AppUserId bigint,@RequestId uniqueidentifier,@Operation varchar(40),
 @EntityType varchar(60),@EntityId bigint
AS
BEGIN
 SET NOCOUNT ON;
 IF @@TRANCOUNT=0 OR XACT_STATE()<>1 THROW 53020,''An atomic domain transaction is required.'',1;
 IF @EntityId IS NULL OR @EntityId<=0 OR NULLIF(@EntityType,'''') IS NULL
   THROW 53021,''Invalid audit reference.'',1;
 -- Existing tr_AuditLog_CommandOnly is preserved, not bypassed.
 -- A separately approved domain gateway must own and validate the command context.
 IF COALESCE(APPLOCK_MODE(''public'',''SongLam:Inventory'',''Transaction''),''NoLock'')<>''Exclusive''
   OR NOT EXISTS(SELECT 1 FROM pms.CommandExecution c
     JOIN pms.ApiRequest r WITH(UPDLOCK,HOLDLOCK) ON r.RequestId=c.RequestId
     JOIN pms.AppUser u WITH(UPDLOCK,HOLDLOCK) ON u.UserId=r.ActorId
     WHERE c.SessionId=@@SPID AND c.RequestId=@RequestId AND r.ActorId=@AppUserId
       AND r.Operation=@Operation AND r.Status=''PROCESSING'' AND u.IsActive=1)
   THROW 53022,''Validated command context required.'',1;
 INSERT pms.AuditLog(ActorId,Action,EntityType,EntityKey,RequestId,BeforeJson,AfterJson,Reason)
 VALUES(@AppUserId,@Operation,@EntityType,CONVERT(varchar(20),@EntityId),@RequestId,NULL,NULL,NULL);
 -- No password/hash/session/customer payload copied into audit.
 -- No acknowledgement until the calling domain RPC commits the entire transaction.
END';
COMMIT;
END TRY
BEGIN CATCH
 IF XACT_STATE()<>0 ROLLBACK;
 THROW;
END CATCH;

