-- Part of the foundation approval package. Never executed automatically.
SET NOCOUNT ON;
DECLARE @ApprovalReference nvarchar(200)=N'USER-FOUNDATION-011-BACKUP-DEPLOY-IMPORT';
IF NULLIF(@ApprovalReference,N'') IS NULL THROW 54030,'Foundation backup execution not approved.',1;
IF DB_NAME()<>N'SongLamPms_Design' OR CONVERT(nvarchar(128),SERVERPROPERTY('ServerName'))<>N'DESKTOP-9EPI86K\SQLEXPRESS'
 OR NOT EXISTS(SELECT 1 FROM sys.database_recovery_status WHERE database_id=DB_ID() AND database_guid='C4DD399E-5661-4741-A424-5ABFEEFBC1AC')
 THROW 54031,'Unexpected backup target.',1;
IF @@TRANCOUNT<>0 THROW 54032,'No transaction permitted during backup.',1;
DECLARE @path nvarchar(4000)=N'C:\Program Files\Microsoft SQL Server\MSSQL16.SQLEXPRESS\MSSQL\Backup\SongLamPms_Design_Foundation420_'+CONVERT(nvarchar(36),NEWID())+N'.bak';
BACKUP DATABASE [SongLamPms_Design] TO DISK=@path WITH COPY_ONLY,CHECKSUM;
RESTORE VERIFYONLY FROM DISK=@path WITH CHECKSUM;
SELECT TOP(1) b.backup_set_uuid,b.backup_finish_date,m.physical_device_name
 FROM msdb.dbo.backupset b JOIN msdb.dbo.backupmediafamily m ON m.media_set_id=b.media_set_id
 WHERE b.database_name=N'SongLamPms_Design' AND m.physical_device_name=@path ORDER BY b.backup_set_id DESC;
