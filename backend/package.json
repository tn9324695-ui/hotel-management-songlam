{
  "name": "songlam-pms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SongLam PMS Express API. SQL test runtime requires explicit approved configuration.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser/login.browser.js",
    "test:browser:auth": "node tests/browser/auth.browser.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "msnodesqlv8": "6.2.2",
    "mssql": "12.7.14"
  }
}
