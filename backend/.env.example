# Copy to backend/.env. HTTP settings are required; values below are local development only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_PROVIDER=sqlserver
SQL_DATABASE=SongLamPms_Design
# Unverified dependencies: intentionally empty. G1 does not open any SQL connection.
SQL_SERVER=
SQL_PORT=
# No SQL password, session secret, authentication switch or PostgreSQL URL is needed for G1.

# G12 preparation ONLY. Existing demo remains the default; do not edit live .env here.
# demo | frozen | api-readonly | sql. SQL also requires separately approved live adapters.
PMS_WRITE_MODE=demo
PMS_BUILD_ID=
PMS_RELEASE_FILE=
# See deploy/cutover/release.example.json; no credentials in the release record.

# Opt-in TEST runtime only. No file => no driver/pool loading or SQL calls.
# NODE_ENV=test and an approved absolute-path manifest are required.
# Do not fill this using metadata credentials or an unapproved SQL proposal.
SQL_RUNTIME_FILE=
# Supply SONGLAM_SESSION_EPOCH only through the process secret environment/vault.
